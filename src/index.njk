{% extends "base.njk" %}

{% block content %}
<main class="broadsheet-grid">

  {# TOP SECTION: Lead Article + Recent Items #}
  <section class="lead-section">
    {# Get the most recent article #}
    {% set leadArticle = collections.articles | reverse | first %}
    
    {% if leadArticle %}
      <div class="lead-hero">
        {% set article = leadArticle %}
        {% include "partials/card-hero.njk" %}
      </div>
    {% endif %}

    {# Sidebar: Display next 3 articles #}
    <div class="lead-sidebar">
      <h4 class="section-tag">ALSO TODAY</h4>
      {% for article in collections.articles | reverse %}
        {% if loop.index > 1 and loop.index <= 4 %}
          {% include "partials/card-compact.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <hr class="broadsheet-divider">

  {# ACCUMULATION SECTION: All remaining/older articles #}
  <section class="accumulating-archive">
    <h3 class="section-header">DISPATCHES & ARCHIVE</h3>
    <div class="multi-column-masonry">
      {% for article in collections.articles | reverse %}
        {% if loop.index > 4 %}
          {% include "partials/card-compact.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </section>

</main>
{% endblock %}
