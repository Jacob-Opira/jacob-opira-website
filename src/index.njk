---
layout: base.njk
---
{% set posts = collections.articles | reverse %}

<main class="broadsheet-grid">

  <section class="lead-section">
    <div class="lead-hero">
      {% for article in posts.slice(0, 1) %}
        {% include "partials/card-hero.njk" %}
      {% endfor %}
    </div>
    <div class="lead-sidebar">
      <h4 class="middle-tier-header">Also Today</h4>
      {% for article in posts.slice(1, 4) %}
        {% include "partials/card-compact.njk" %}
      {% endfor %}
    </div>
  </section>

  {% if posts.length > 4 %}
  <hr class="broadsheet-divider">
  <section class="middle-tier-section">
    <h3 class="middle-tier-header">Essays &amp; Perspectives</h3>
    <div class="three-column-grid">
      {% for article in posts.slice(4, 7) %}
        {% include "partials/card-opinion.njk" %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if posts.length > 7 %}
  <hr class="broadsheet-divider">
  <section class="accumulating-archive">
    <h3 class="middle-tier-header">Dispatches &amp; Archive</h3>
    <div class="multi-column-masonry">
      {% for article in posts.slice(7) %}
        {% include "partials/card-compact.njk" %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

</main>
