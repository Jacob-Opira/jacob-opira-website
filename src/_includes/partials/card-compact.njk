<article class="compact-card">
  {% if article.data.image %}
    <img src="{{ article.data.image }}" alt="{{ article.data.image_alt | default('') }}" class="thumb">
  {% endif %}
  <div class="compact-card__body">
    <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
    {% if article.data.deck %}
      <p>{{ article.data.deck }}</p>
    {% endif %}
  </div>
</article>
