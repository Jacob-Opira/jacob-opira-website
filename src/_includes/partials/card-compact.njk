<article class="compact-card">
  {% if article.data.image %}<img class="thumb" src="{{ article.data.image }}" alt="{{ article.data.image_alt | default('') }}">{% endif %}
  <div class="compact-card__body">
    {% if article.data.kicker or article.data.category %}<span class="kicker">{{ article.data.kicker or article.data.category }}</span>{% endif %}
    <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
    {% if article.data.deck %}<p>{{ article.data.deck }}</p>{% endif %}
  </div>
</article>
