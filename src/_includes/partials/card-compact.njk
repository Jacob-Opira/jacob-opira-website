<article class="compact-card">
  <div class="compact-text">
    <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
    <p>{{ article.data.excerpt }}</p>
    <time>{{ article.date | date("DD MMMM YYYY") }}</time>
  </div>
  {% if article.data.featured_image %}
    <img src="{{ article.data.featured_image }}" alt="" class="thumb">
  {% endif %}
</article>
