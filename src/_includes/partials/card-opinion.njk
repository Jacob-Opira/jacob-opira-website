<article class="opinion-card">
  {% if article.data.kicker or article.data.category %}
    <span class="kicker">{{ article.data.kicker | default(article.data.category) }}</span>
  {% endif %}
  <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
  {% if article.data.deck %}
    <p class="excerpt">{{ article.data.deck }}</p>
  {% endif %}
  <time>{{ article.date | readableDate }}</time>
</article>
